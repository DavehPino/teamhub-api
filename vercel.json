{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "functions": {
    "api/admin/[action].ts": { "maxDuration": 60 },
    "api/flyers/[action].ts": { "maxDuration": 60 },
    "api/cron/sync-videos.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/sync-videos", "schedule": "0 12 * * *" }]
}
