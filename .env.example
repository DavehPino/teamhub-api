# Copia este archivo a `.env.local` (desarrollo) y carga las mismas variables en
# Vercel → Project → Settings → Environment Variables. Todas son SOLO servidor.

# ─── Equipo ──────────────────────────────────────────────────────────────────
# Slug (organizations.slug) de la organización por defecto: atiende las peticiones sin cabecera x-org-slug (la web
# de Coyotes) y es la única a la que dan acceso las palabras clave compartidas. Otras organizaciones se eligen con
# la cabecera x-org-slug y se administran con sesión de Supabase Auth. Si falta, se usa 'coyotes'.
# (ORG_ID se acepta como alias del nombre anterior.)
DEFAULT_ORG_SLUG=coyotes
# Opcional: descripción libre del equipo para el asistente de flyers (deporte, ciudad, mascota, colores, tono,
# variante del español). El nombre del equipo sale de la tabla teams (is_own_team = true).
# TEAM_PROFILE=Comunidad de vóley de Buenos Aires. Colores negro y dorado. Escribe con voseo ("vení", "sumate").

# ─── Supabase (Project Settings → API Keys) ──────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (sb_secret_...) o service_role. Ignora RLS: NUNCA exponer al cliente.
SUPABASE_SECRET_KEY=

# ─── Bucket de videos (API compatible con S3) ────────────────────────────────
# Cloudflare R2: copia el "S3 API" de Bucket → Settings (sin el /<bucket> final). Depende de la
# jurisdicción: https://<ACCOUNT_ID>[.us|.eu].r2.cloudflarestorage.com  | AWS S3: dejar vacío
S3_ENDPOINT=
# R2: auto | AWS: p.ej. us-east-1
S3_REGION=auto
S3_BUCKET=team-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpeta dentro del bucket donde viven los videos (vacío = todo el bucket)
S3_VIDEO_PREFIX=
# Opcional: URL pública del bucket (dominio propio o r2.dev). Si está vacía,
# se generan URLs firmadas temporales para reproducir.
STORAGE_PUBLIC_BASE_URL=
# Duración de las URLs firmadas en segundos
SIGNED_URL_TTL_SECONDS=3600

# ─── Escritura desde el dashboard ────────────────────────────────────────────
# Palabra clave de /api/admin/*. Sin ella, esas rutas responden 503.
# Usa una frase larga: no hay límite de intentos, solo una pausa tras cada fallo.
ADMIN_SAFEWORD=
# Palabra clave de /api/flyers/* (subir o borrar imágenes y flyers en el bucket y usar la IA), distinta de la
# anterior. Sin ella, los POST de /api/flyers/* responden 503 (GET /api/flyers/library sigue siendo libre).
FLYERS_SAFEWORD=

# ─── Asistente de flyers (OpenRouter) ────────────────────────────────────────
# Clave de https://openrouter.ai/keys. Sin ella, /api/flyers/suggest responde 503.
OPENROUTER_API_KEY=
# Opcional: modelo concreto (p.ej. un id terminado en ":free") o lista separada por comas; el primero es el principal
# y el resto, respaldo si falla. Por defecto `openrouter/free` elige uno gratuito en cada llamada.
# OPENROUTER_MODEL=openrouter/free

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Vercel lo envía como `Authorization: Bearer <CRON_SECRET>` al llamar al cron.
CRON_SECRET=

# ─── Sincronización con CourtTrack (microservicio courtrack-service) ─────────
# URL del deploy del microservicio (repo aparte) y el mismo token que su SYNC_SECRET.
# Sin ellos, /api/admin/courtrack-* y /api/matches/:slug?view=stats responden 503.
COURTRACK_SYNC_URL=https://courtrack-service.vercel.app
COURTRACK_SYNC_SECRET=
